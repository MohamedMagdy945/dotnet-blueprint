{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ApiSettings": {
    "Name": "Blueprint API",
    "Version": "1.0"
  },
  "Jwt": {
    "Issuer": "MyApi",
    "Audience": "MyApiClient",
    "AccessTokenExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7
  },
  "ExternalServices": {
    "Email": {
      "BaseUrl": "",
      "TimeoutInSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
